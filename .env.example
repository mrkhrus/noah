# NOAH — environment variables. Copy to .env.local for local dev, or set in Vercel.
# NEVER commit a real .env.local. Never put real secrets in this file.

# --- Database ---
# Local dev (SQLite). For production Postgres, use your Postgres URL and switch
# the provider in prisma/schema.prisma to "postgresql" (see DEPLOY.md).
DATABASE_URL="file:./dev.db"

# --- App ---
# Public base URL of the app (used for OAuth redirects and email links).
APP_URL="http://localhost:3000"
# Random secret for signing session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret"
# 32-byte hex key for encrypting stored Google OAuth tokens. Generate with: openssl rand -hex 32
ENCRYPTION_KEY="change-me-to-64-hex-characters-0123456789abcdef0123456789abcdef"

# --- Google Gemini (AI chat) ---
# Get a free key at https://aistudio.google.com/apikey
# If this is missing, chat honestly reports that AI is not configured — it never fakes answers.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Google OAuth (sign-in + per-user account connections) ---
# Create an OAuth client in Google Cloud Console (see DEPLOY.md).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email (verification + password reset) ---
# Any SMTP server works. If unset in development, verification links are printed
# to the server console and returned in the signup response (dev only).
# In production without SMTP, sign-up returns an honest error instead of silently failing.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NOAH <no-reply@example.com>"

# --- Vercel Cron (task queue runner) ---
# Random secret so only Vercel Cron can call /api/tasks/run. Generate with: openssl rand -hex 16
CRON_SECRET=""
